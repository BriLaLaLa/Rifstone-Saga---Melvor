[node name="AffixRow" type="HBoxContainer" parent="Detail/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="AffixLabel" type="Label" parent="Detail/Box/AffixRow"]
