[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/pages/combat/combatant_card.gd" id="1_card"]

[node name="CombatantCard" type="PanelContainer"]
custom_minimum_size = Vector2(260, 150)
theme_type_variation = &"HudPanel"
script = ExtResource("1_card")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"

[node name="SubtitleLabel" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="HpBar" type="ProgressBar" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
step = 1.0

[node name="HpLabel" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="TimerBar" type="ProgressBar" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0

[node name="HitLabel" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
mouse_filter = 2
