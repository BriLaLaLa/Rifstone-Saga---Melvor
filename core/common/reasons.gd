const DISCIPLINE_SLOTS_FULL := &"discipline_slots_full"  # M24: no free discipline place in the category
const NOT_A_DISCIPLINE := &"not_a_discipline"  # M24: the skill has no Trainer
const MAX_GRADE := &"max_grade"  # M24: the discipline is at its highest grade
const DISCIPLINE_BUSY := &"discipline_busy"  # M24: the discipline of the node being worked cannot be unlearned
