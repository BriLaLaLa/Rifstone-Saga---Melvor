class_name VillageBuildingDef
extends RefCounted
## One building of data/village/buildings.json (docs/04_DATA_SCHEMA.md §24, M19).
##
## A placeholder (`buildable` false: market, noticeboard) has a `milestone` and no effect or levels. A buildable one has
## `effect_*` and `levels`: one dictionary per level 1..max_level, `{level: int, requires_woodwright: int, gold: int,
## items: [{item: StringName, qty: int}], effect_value: float}` (generated by tools/gen_village.gd). `from_dict` returns
## null (after logging, see DefReader) if a field is missing or mistyped.

var id: StringName = &""
var name: String = ""
var description: String = ""
var icon: String = ""
var order: int = 0
var buildable: bool = false
var milestone: int = 0
var map_pos: Vector2 = Vector2.ZERO  # M21: node position on the village map, 0..1 (presentation only)
var page: StringName = &""  # M21: page id of the Open button (`noticeboard`, `shop`); empty if none
var unlocks_shop: bool = false  # M20: the level opens shop entries (`requires.village`); no modifier effect
var effect_stat: StringName = &""
var effect_scope: String = "global"
var effect_per_level: float = 0.0
var levels: Array[Dictionary] = []


static func from_dict(d: Dictionary) -> VillageBuildingDef:
	var r := DefReader.new(d, "village building")
	var def := VillageBuildingDef.new()
	def.id = r.id("id")
	r.set_context("village building '%s'" % def.id)
	def.name = r.text("name")
	def.description = r.text("description")
	def.icon = r.text("icon")
	def.order = r.integer("order")
	def.buildable = r.flag("buildable")
	var pos: Variant = d.get("map_pos")
	if pos is Array and (pos as Array).size() == 2 and (pos[0] is float or pos[0] is int) and (pos[1] is float or pos[1] is int):
		def.map_pos = Vector2(float(pos[0]), float(pos[1]))
	else:
		r.fail("field 'map_pos' must be [x, y]")
	if r.has("page"):
		def.page = r.id("page")
	if r.has("milestone"):
		def.milestone = r.integer("milestone")
	if r.has("unlocks_shop"):
		def.unlocks_shop = r.flag("unlocks_shop")
	if r.has("effect") and r.is_dict("effect"):
		var effect := DefReader.new(r.dict("effect"), r.context() + " effect")
		def.effect_stat = effect.id("stat")
		def.effect_scope = effect.text("scope")
		def.effect_per_level = effect.number("per_level")
		r.absorb(effect.ok)
	for level: Dictionary in r.dict_list("levels"):
		var entry: Dictionary = _read_level(level, r)
		if not entry.is_empty():
			def.levels.append(entry)
	return def if r.ok else null


static func _read_level(d: Dictionary, parent: DefReader) -> Dictionary:
	var r := DefReader.new(d, parent.context() + " level")
	var entry: Dictionary = {"level": r.integer("level"), "requires_woodwright": r.integer("requires_woodwright"),
			"gold": r.integer("gold"), "effect_value": r.number("effect_value")}
	var items: Array[Dictionary] = []
	for row: Dictionary in r.dict_list("items"):
		var qty: ItemQty = ItemQty.from_dict(row)
		r.absorb(qty != null)
		if qty != null:
			items.append({"item": qty.item_id, "qty": qty.qty})
	entry["items"] = items
	parent.absorb(r.ok)
	return entry if r.ok else {}
