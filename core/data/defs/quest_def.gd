class_name QuestDef
extends RefCounted
## One quest of data/quests/quests.json (docs/04_DATA_SCHEMA.md §25, M20; generated by tools/gen_quests.gd, F-134).
##
## `type` is `kill`, `gather` or `craft`; `skill` and `item` are empty for `kill`. `reward_xp_skill` is empty and
## `reward_xp` 0 when there is no XP reward. `from_dict` returns null (after logging, see DefReader) if a field is
## missing or mistyped.

var id: StringName = &""
var name: String = ""
var description: String = ""
var type: StringName = &""
var tier: int = 0
var skill: StringName = &""
var item: StringName = &""
var target: int = 0
var req_character: int = 1
var req_skills: Dictionary[StringName, int] = {}
var reward_gold: int = 0
var reward_xp_skill: StringName = &""
var reward_xp: int = 0
var reward_items: Array[ItemQty] = []


static func from_dict(d: Dictionary) -> QuestDef:
	var r := DefReader.new(d, "quest")
	var def := QuestDef.new()
	def.id = r.id("id")
	r.set_context("quest '%s'" % def.id)
	def.name = r.text("name")
	def.description = r.text("description")
	def.type = r.id("type")
	def.tier = r.integer("tier")
	if r.has("skill"):
		def.skill = r.id("skill")
	if r.has("item"):
		def.item = r.id("item")
	def.target = r.integer("target")
	if r.is_dict("requires"):
		var requires := DefReader.new(r.dict("requires"), r.context() + " requires")
		def.req_character = requires.integer("character")
		def.req_skills = requires.level_map("skills")
		r.absorb(requires.ok)
	if r.is_dict("reward"):
		_read_reward(def, r)
	return def if r.ok else null


static func _read_reward(def: QuestDef, parent: DefReader) -> void:
	var r := DefReader.new(parent.dict("reward"), parent.context() + " reward")
	def.reward_gold = r.integer("gold")
	if r.has("xp") and r.is_dict("xp"):
		var xp := DefReader.new(r.dict("xp"), r.context() + " xp")
		def.reward_xp_skill = xp.id("skill")
		def.reward_xp = xp.integer("amount")
		r.absorb(xp.ok)
	for row: Dictionary in r.dict_list("items"):
		var qty: ItemQty = ItemQty.from_dict(row)
		r.absorb(qty != null)
		if qty != null:
			def.reward_items.append(qty)
	parent.absorb(r.ok)
