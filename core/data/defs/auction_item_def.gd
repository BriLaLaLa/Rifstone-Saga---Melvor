class_name AuctionItemDef
extends RefCounted
## One entry of data/auction/auction_items.json (docs/04_DATA_SCHEMA.md §28; generated by tools/gen_auction.gd): an item
## the Auction House trades. `buy_level` 0 = sell only; 1..max_level = can also be bought with the building at that level.
## `from_dict` returns null (after logging, see DefReader) if a field is missing or mistyped.

var item: StringName = &""
var buy_level: int = 0


static func from_dict(d: Dictionary) -> AuctionItemDef:
	var r := DefReader.new(d, "auction item")
	var def := AuctionItemDef.new()
	def.item = r.id("item")
	r.set_context("auction item '%s'" % def.item)
	def.buy_level = r.integer("buy_level")
	return def if r.ok else null
