extends GutTest
## P-03 (UI): Rune and Incavi names, Altar socket states and rune list, top bar following `player_renamed`,
## Guide tables of traits and abilities generated by LoadoutDescribe.

const RIFT_SCENE: PackedScene = preload("res://ui/pages/rift/rift_page.tscn")
const TOP_BAR_SCENE: PackedScene = preload("res://ui/screens/main/top_bar.tscn")
const INF: StringName = &"test_infusion"

var _session: GameSession = null
var _node: Node = null


func before_each() -> void:
	_session = TestFactory.session()


func after_each() -> void:
	if is_instance_valid(_node):
		_node.free()
	if is_instance_valid(_session):
		_session.free()
	await wait_physics_frames(1)


func _open(scene: PackedScene) -> void:
	_node = scene.instantiate()
	add_child(_node)
	_node.bind(_session)


func _text(node_name: String) -> String:
	var node: Node = _node.find_child(node_name, true, false)
	return (node as Label).text if node is Label else (node as RichTextLabel).text


func test_top_bar_follows_player_renamed() -> void:
	_open(TOP_BAR_SCENE)
	assert_true(_text("SlotLabel").begins_with(_session.player_name))
	assert_true(PlayerName.rename(_session, "Nuovo Nome").ok)
	assert_true(_text("SlotLabel").begins_with("Nuovo Nome"))
	_node.unbind()
	assert_false(_session.events.player_renamed.get_connections().size() > 0)


func test_rename_to_same_name_does_not_emit() -> void:
	_session.player_name = "Ada"
	watch_signals(_session.events)
	assert_true(PlayerName.rename(_session, " Ada ").ok)
	assert_signal_not_emitted(_session.events, "player_renamed")
	assert_true(PlayerName.rename(_session, "Altro").ok)
	assert_signal_emitted_with_parameters(_session.events, "player_renamed", ["Altro"])


func test_altar_sockets_say_what_to_do() -> void:
	_open(RIFT_SCENE)
	for i: int in _session.rift.socket_total():
		var row: Node = _node.find_child("Socket%d" % i, true, false)
		var text: String = (row.find_child("StateText", true, false) as RichTextLabel).text
		if _session.rift.is_unlocked(i):
			assert_string_contains(text, "Libero")
			assert_string_contains(text, "scegli una runa")
		else:
			assert_string_contains(text, "Si sblocca con %s al livello %d" % [RiftTexts.skill_name(_session),
					RiftTexts.unlock_level(_session, i)])


func test_altar_lists_runes_with_description_and_craft_link() -> void:
	_session.bank.add(INF, 2)
	_open(RIFT_SCENE)
	var line: Label = _node.find_child("Rune_%s" % INF, true, false) as Label
	assert_not_null(line)
	var def: ItemDef = _session.data.item(INF)
	assert_string_contains(line.text, RiftTexts.modifiers_inline(def.infusion_modifiers, _session.data))
	assert_string_contains(line.text, "x2")
	assert_not_null(_node.find_child("CraftRunesButton", true, false))


func test_altar_without_runes_says_so() -> void:
	_open(RIFT_SCENE)
	assert_eq(_text("NoRunes"), RiftTexts.NO_INFUSIONS_TEXT)


func test_category_and_guide_header_say_rune() -> void:
	assert_eq(ItemTooltipLines.CATEGORY_NAMES[&"infusion"], "Runa")
	assert_eq(GuideTables.build("infusions", _session.data)[0][0], "Runa")


func test_guide_tables_use_loadout_describe() -> void:
	var data: GameData = _session.data
	var class_def: ClassDef = data.classes()[0]
	var traits: Array[Array] = GuideTables.build("traits", data)
	assert_eq(traits[1][2], LoadoutDescribe.trait_text(class_def.traits[0], data, class_def))
	var abilities: Array[Array] = GuideTables.build("abilities", data)
	assert_eq(abilities[1][3], LoadoutDescribe.ability_text(class_def.abilities[0], data, class_def))
