extends GutTest
## Areas, monsters and packs of the real data (02_FORMULAS.md §8.5; 04_DATA_SCHEMA.md §8). M17-04: ten narrow areas generated by
## tools/gen_areas.gd; the rules of §8.5 are the oracle (the numbers of the curve live in the generator).

## [area id, level_min, level_max], in order.
const AREAS: Array[Array] = [
	["redrock_plains", 1, 10], ["whisper_wood", 11, 20], ["dry_uplands", 21, 30], ["cracked_mines", 31, 40], ["ash_marsh", 41, 50],
	["weeping_gorge", 51, 60], ["rift_threshold", 61, 70], ["black_glass_desert", 71, 80], ["sunken_citadel", 81, 90],
	["rift_heart", 91, 99],
]

var _areas: Array = []
var _monsters: Dictionary = {}
var _items: Dictionary = {}


func before_all() -> void:
	_areas = _read("res://data/combat/areas.json")["areas"]
	for m: Dictionary in _read("res://data/combat/monsters.json")["monsters"]:
		_monsters[m["id"]] = m
	for file: String in DirAccess.get_files_at("res://data/items"):  # the item files are split by kind (M14)
		if file.ends_with(".json"):
			for m: Dictionary in _read("res://data/items/%s" % file)["items"]:
				_items[m["id"]] = m


func _read(path: String) -> Dictionary:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	return parsed as Dictionary


func _level(m: Dictionary) -> int:
	return maxi(int(m["attack_level"]), maxi(int(m["power_level"]), int(m["defence_level"])))


func _area_monsters(area: Dictionary) -> Array[String]:
	var ids: Array[String] = []
	for p: Dictionary in area["packs"]:
		for id: String in p["monsters"]:
			if not ids.has(id):
				ids.append(id)
	return ids


func test_ten_areas_and_fifty_monsters() -> void:
	assert_eq(_areas.size(), 10)
	assert_eq(_monsters.size(), 50)


func test_areas_order_levels_and_requirements() -> void:
	for i: int in AREAS.size():
		var a: Dictionary = _areas[i]
		assert_eq(a["id"], AREAS[i][0])
		assert_eq(int(a["order"]), i + 1)
		assert_eq([int(a["level_min"]), int(a["level_max"])], [AREAS[i][1], AREAS[i][2]], "%s levels" % a["id"])
		assert_eq(int(a["requirements"]["character"]), AREAS[i][1], "requirement = level_min")
		assert_eq((a["requirements"] as Dictionary).size(), 1)
		assert_eq((a["map_pos"] as Array).size(), 2)


func test_every_area_has_four_or_more_own_monsters_inside_its_levels() -> void:
	var owner: Dictionary = {}
	for a: Dictionary in _areas:
		var ids: Array[String] = _area_monsters(a)
		assert_gte(ids.size(), 4, "%s monsters" % a["id"])
		var near_min: bool = false
		var near_max: bool = false
		for id: String in ids:
			assert_false(owner.has(id), "%s is in two areas" % id)
			owner[id] = a["id"]
			var level: int = _level(_monsters[id])
			assert_between(level, int(a["level_min"]), int(a["level_max"]), "%s level" % id)
			near_min = near_min or absi(level - int(a["level_min"])) <= 1
			near_max = near_max or absi(level - int(a["level_max"])) <= 1
		assert_true(near_min, "%s has a monster at level_min +-1" % a["id"])
		assert_true(near_max, "%s has a monster at level_max +-1" % a["id"])
	assert_eq(owner.size(), _monsters.size(), "every monster is in some pack")


func test_packs_have_every_size_with_the_weights_of_the_balance() -> void:
	var weights: Array = _read("res://data/config/balance.json")["combat"]["pack_size_weights"]
	for a: Dictionary in _areas:
		var by_size: Dictionary = {}
		for p: Dictionary in a["packs"]:
			assert_gte(int(p["weight"]), 1)
			by_size[(p["monsters"] as Array).size()] = int(by_size.get((p["monsters"] as Array).size(), 0)) + int(p["weight"])
		for size: int in range(1, 9):
			assert_eq(by_size.get(size, 0), int(weights[size - 1]), "%s size %d" % [a["id"], size])


func test_the_weakest_monster_walks_alone() -> void:
	for a: Dictionary in _areas:
		var ids: Array[String] = _area_monsters(a)
		ids.sort_custom(func(x: String, y: String) -> bool: return _level(_monsters[x]) < _level(_monsters[y]))
		var solo: Array = []
		for p: Dictionary in a["packs"]:
			if (p["monsters"] as Array).size() == 1:
				solo = p["monsters"]
		assert_eq(solo, [ids[0]], "%s solo pack" % a["id"])


func test_reference_monsters_keep_their_anchor_values() -> void:
	var boar: Dictionary = _monsters["plains_boar"]
	assert_eq([int(boar["hp"]), _level(boar), int(boar["xp"])], [20, 1, 80], "the level 1 anchor of the curve")
	assert_eq(int(_monsters["riftborn_colossus"]["attack_level"]), 99)


func test_hp_grows_with_the_level_inside_a_role() -> void:
	var by_level: Array[Dictionary] = []
	for m: Dictionary in _monsters.values():
		by_level.append(m)
	by_level.sort_custom(func(x: Dictionary, y: Dictionary) -> bool: return _level(x) < _level(y))
	assert_lt(int(by_level[0]["hp"]), int(by_level[-1]["hp"]))
	for m: Dictionary in _monsters.values():
		assert_gte(int(m["hp"]), 1)
		assert_between(float(m["damage_reduction"]), 0.0, 25.0, "%s dr" % m["id"])
		assert_lte(int(m["power_level"]), _level(m), "%s power is not above the level" % m["id"])


func test_drops_use_existing_items() -> void:
	for m: Dictionary in _monsters.values():
		var drops: Array = m["drops"]
		assert_between(drops.size(), 1, 8, "%s drop count" % m["id"])
		for d: Dictionary in drops:
			assert_true(_items.has(d["item"]), "%s drops unknown %s" % [m["id"], d["item"]])
			# Blueprints are rare on purpose (about one per hour in the whole area, Q49): below the 1% of the other drops.
			var low: float = 0.05 if str(d["item"]).begins_with("bp_") else 1.0
			assert_between(float(d["chance_pct"]), low, 40.0, "%s %s" % [m["id"], d["item"]])


func test_icons_exist() -> void:
	for m: Dictionary in _monsters.values():
		assert_true(FileAccess.file_exists(m["icon"]), "icon %s" % m["icon"])
	for item: Dictionary in _items.values():
		assert_true(FileAccess.file_exists(item["icon"]), "icon %s" % item["icon"])


func test_names_are_unique() -> void:
	var names: Dictionary = {}
	for m: Dictionary in _monsters.values():
		assert_false(names.has(m["name"]), "duplicate name %s" % m["name"])
		names[m["name"]] = true
	for a: Dictionary in _areas:
		assert_false(names.has(a["name"]), "duplicate name %s" % a["name"])
		names[a["name"]] = true


func test_slot_and_class_icons_exist() -> void:
	for slot: String in DataValidatorItems.EQUIP_SLOTS:
		assert_true(FileAccess.file_exists("res://assets/icons/slots/%s.svg" % slot), "slot icon %s" % slot)
	var cls: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/classes/rift_blade.json"))
	assert_true(FileAccess.file_exists(cls["icon"]), "class icon %s" % cls["icon"])


func test_xp_follows_f130_generator() -> void:
	# M17-03: xp = round(monster_xp.base x monster_xp.growth^(L - 1)), written by tools/gen_monster_xp.gd.
	var spec: Dictionary = _read("res://data/config/balance.json")["combat"]["monster_xp"]
	for m: Dictionary in _monsters.values():
		var expected: int = int(round(float(spec["base"]) * pow(float(spec["growth"]), float(_level(m) - 1))))
		assert_eq(int(m["xp"]), expected, "%s xp" % m["id"])


## B1 (02_FORMULAS.md B1, F-130): a character of any level L has an area it can enter (level_min <= L) with a monster at
## d = L_m - L >= -8, so there is never a level without xp ("dead zone").
func test_no_level_without_xp() -> void:
	var zero_gap: int = int(_read("res://data/config/balance.json")["combat"]["xp_level"]["zero_gap"])
	for level: int in range(1, 100):
		var best: int = -1000
		for a: Dictionary in _areas:
			if int(a["requirements"]["character"]) <= level:
				for id: String in _area_monsters(a):
					best = maxi(best, _level(_monsters[id]) - level)
		assert_gt(best, -zero_gap, "level %d has a monster with xp" % level)
		assert_gte(best, -8, "level %d: d >= -8" % level)
