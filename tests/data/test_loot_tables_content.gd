extends GutTest
## The real loot tables (02_FORMULAS.md §8.5b, docs/04_DATA_SCHEMA.md §8b): one table per area, one per Monolito, the starting
## values of the formulas. M17-04: ten areas generated by tools/gen_areas.gd; each area has the table of its tier (0-3, the four
## wide areas of M12). Starting values: M12-07 may retune them in the data.

## Area id -> tier of its tables.
const TIERS: Dictionary = {"redrock_plains": 0, "whisper_wood": 1, "dry_uplands": 1, "cracked_mines": 2, "ash_marsh": 2,
		"weeping_gorge": 2, "rift_threshold": 3, "black_glass_desert": 3, "sunken_citadel": 3, "rift_heart": 3}
const FAMILIES: Array[String] = ["ember", "eye", "shade", "root"]
const TRADES: Array[String] = ["forestry", "quarrying", "angling"]
## The contract grade of each tier: the highest one dropped there and the grade of its Monolito.
const MAX_GRADE: Array[String] = ["apprentice", "journeyman", "expert", "master"]

var _data: GameData


func before_all() -> void:
	_data = TestFactory.real_data()


func _chance(table: String, item: String) -> float:
	for entry: DropEntry in _data.loot_table(StringName(table)).entries:
		if entry.item_id == StringName(item):
			return entry.chance_pct
	return -1.0


func _qty(table: String, item: String) -> Array[int]:
	for entry: DropEntry in _data.loot_table(StringName(table)).entries:
		if entry.item_id == StringName(item):
			return [entry.qty_min, entry.qty_max]
	return []


func _areas_of_tier(tier: int) -> Array[String]:
	var out: Array[String] = []
	for area_id: String in TIERS:
		if TIERS[area_id] == tier:
			out.append(area_id)
	return out


func test_every_area_and_monolith_has_its_table() -> void:
	assert_eq(_data.loot_tables().size(), 20)
	for area_id: String in TIERS:
		assert_eq(_data.area(StringName(area_id)).loot_tables, [StringName("loot_area_" + area_id)] as Array[StringName], area_id)
		for stone: RiftStoneDef in _data.rift_stones_for_area(StringName(area_id)):  # every stone of an area shares its table
			assert_eq(stone.loot_tables, [StringName("loot_monolith_" + area_id)] as Array[StringName], stone.id)


func test_area_tables_follow_8_5b() -> void:
	for area_id: String in TIERS:
		var table: String = "loot_area_" + area_id
		assert_eq(_chance(table, "rift_dust"), 8.0, table)  # M14, Q71
		assert_eq(_qty(table, "rift_dust"), [1, 1] as Array[int], table)
		for family: String in FAMILIES:
			assert_eq(_chance(table, "stone_%s_chip" % family), 1.0, table)
			assert_eq(_chance(table, "stone_%s_heart" % family), -1.0, "no perfect stone from the monsters")
			assert_eq(_chance(table, "stone_%s_stone" % family), 0.05 if TIERS[area_id] >= 1 else -1.0, table)
		assert_eq([_chance(table, "currency_spark"), _chance(table, "currency_flux"), _chance(table, "currency_crown")],
				[0.05, 0.03, 0.02] if TIERS[area_id] >= 1 else [-1.0, -1.0, -1.0], table)


func test_bags_of_the_areas() -> void:
	for area_id: String in TIERS:
		var table: String = "loot_area_" + area_id
		assert_eq(_chance(table, "bag_leather"), 0.05 if TIERS[area_id] <= 1 else -1.0, table)
		assert_eq(_chance(table, "bag_wayfarer"), 0.02 if TIERS[area_id] == 2 else -1.0, table)
		assert_eq(_chance(table, "bag_runic"), -1.0, "the runic bag falls only from the Monoliti")


func test_contract_grades_by_tier() -> void:
	# [apprentice, journeyman, expert, master] chance per trade, in the areas of each tier (0.005% is under the 0.01% minimum: 0.01)
	var want: Array = [[0.02, -1.0, -1.0, -1.0], [0.02, 0.015, -1.0, -1.0], [-1.0, 0.015, 0.01, -1.0], [-1.0, -1.0, 0.01, 0.01]]
	for area_id: String in TIERS:
		for trade: String in TRADES:
			for index: int in 4:
				assert_eq(_chance("loot_area_" + area_id, "contract_%s_%s" % [trade, MAX_GRADE[index]]), (want[TIERS[area_id]] as Array)[index],
						"%s %s %d" % [area_id, trade, index])


func test_monolith_tables_follow_8_5b() -> void:
	for area_id: String in TIERS:
		var table: String = "loot_monolith_" + area_id
		var tier: int = TIERS[area_id]
		assert_eq([_chance(table, "rift_dust"), _qty(table, "rift_dust")], [100.0, [20, 40] as Array[int]], table)
		for family: String in FAMILIES:
			assert_eq([_chance(table, "stone_%s_chip" % family), _qty(table, "stone_%s_chip" % family)], [100.0, [2, 4] as Array[int]], table)
			assert_eq(_chance(table, "stone_%s_stone" % family), 20.0, table)
		assert_eq([_chance(table, "currency_spark"), _chance(table, "currency_flux"), _chance(table, "currency_crown")], [15.0, 10.0, 5.0], table)
		for trade: String in TRADES:
			assert_eq(_chance(table, "contract_%s_%s" % [trade, MAX_GRADE[tier]]), 2.0, table)
		assert_eq(_chance(table, "bag_runic"), 5.0 if tier == 3 else -1.0, "only the Monoliti of the last four areas drop the runic bag")


func test_every_new_drop_item_has_a_source_in_the_tables() -> void:
	var dropped: Dictionary = {}
	for table: LootTableDef in _data.loot_tables():
		for entry: DropEntry in table.entries:
			dropped[entry.item_id] = true
	for id: String in ["rift_dust", "bag_leather", "bag_wayfarer", "bag_runic"]:
		assert_true(dropped.has(StringName(id)), id)
	for family: String in FAMILIES:
		assert_true(dropped.has(StringName("stone_%s_chip" % family)), family)
	for trade: String in TRADES:
		for grade: String in MAX_GRADE:
			assert_true(dropped.has(StringName("contract_%s_%s" % [trade, grade])), "%s %s" % [trade, grade])


func test_the_tiers_cover_the_areas_in_order() -> void:
	var last: int = 0
	for area: AreaDef in _data.areas():
		assert_gte(TIERS[String(area.id)], last, "%s tier does not go down" % area.id)
		last = TIERS[String(area.id)]
	assert_eq(_areas_of_tier(0).size() + _areas_of_tier(1).size() + _areas_of_tier(2).size() + _areas_of_tier(3).size(), TIERS.size())
